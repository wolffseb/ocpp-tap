{
  "description": "Executable form of the meter.sample selection rules (M1-M7) and the timestamp rule (T1) in README.md. A decoder must produce exactly these results. sampled_values use OCPP's own key names; expect holds the meter.sample data fields that are not null (an absent key means null); expect null means no event.",
  "meter_samples": [
    {"name": "signed data is skipped", "rules": ["M1"], "connector_id": 1,
     "sampled_values": [{"value": "999", "format": "SignedData"}, {"value": "100", "format": "Raw"}],
     "expect": {"energy_wh": 100}},
    {"name": "only signed data makes no event", "rules": ["M1", "M7"], "connector_id": 1,
     "sampled_values": [{"value": "999", "format": "SignedData"}],
     "expect": null},
    {"name": "defaults: energy, Wh, Outlet", "rules": ["M2", "M3"], "connector_id": 1,
     "sampled_values": [{"value": "1500"}],
     "expect": {"energy_wh": 1500}},
    {"name": "kWh becomes Wh", "rules": ["M2"], "connector_id": 1,
     "sampled_values": [{"value": "1.5", "unit": "kWh"}],
     "expect": {"energy_wh": 1500}},
    {"name": "kW becomes W", "rules": ["M2"], "connector_id": 1,
     "sampled_values": [{"measurand": "Power.Active.Import", "value": "11.5", "unit": "kW"}],
     "expect": {"power_w": 11500}},
    {"name": "octap assumption: no unit on power is W", "rules": ["M2"], "connector_id": 1,
     "sampled_values": [{"measurand": "Power.Active.Import", "value": "7000"}],
     "expect": {"power_w": 7000}},
    {"name": "octap assumption: no unit on current is A", "rules": ["M2"], "connector_id": 1,
     "sampled_values": [{"measurand": "Current.Import", "value": "16"}],
     "expect": {"current_a": 16}},
    {"name": "octap assumption: no unit on SoC is Percent", "rules": ["M2"], "connector_id": 1,
     "sampled_values": [{"measurand": "SoC", "value": "57"}],
     "expect": {"soc_percent": 57}},
    {"name": "all four measurands", "rules": ["M2"], "connector_id": 1,
     "sampled_values": [
       {"value": "1000", "context": "Sample.Periodic"},
       {"measurand": "Power.Active.Import", "value": "7000", "unit": "W"},
       {"measurand": "Current.Import", "value": "16", "unit": "A"},
       {"measurand": "SoC", "value": "57", "unit": "Percent", "location": "EV"}],
     "expect": {"energy_wh": 1000, "power_w": 7000, "current_a": 16, "soc_percent": 57, "context": "Sample.Periodic"}},
    {"name": "a unit the measurand doesn't take is skipped", "rules": ["M2", "M7"], "connector_id": 1,
     "sampled_values": [{"measurand": "Power.Active.Import", "value": "5", "unit": "kvar"}],
     "expect": null},
    {"name": "a value that is not a number is skipped", "rules": ["M2", "M7"], "connector_id": 1,
     "sampled_values": [{"value": "abc"}],
     "expect": null},
    {"name": "NaN and infinity are not numbers", "rules": ["M2", "M7"], "connector_id": 1,
     "sampled_values": [{"value": "NaN"}, {"measurand": "Power.Active.Import", "value": "Inf"}],
     "expect": null},
    {"name": "other measurands are ignored", "rules": ["M2", "M7"], "connector_id": 1,
     "sampled_values": [{"measurand": "Voltage", "value": "230", "unit": "V"}],
     "expect": null},
    {"name": "connector 1 ignores Inlet", "rules": ["M3"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "999", "location": "Inlet"},
       {"measurand": "Power.Active.Import", "value": "100", "location": "Outlet"}],
     "expect": {"power_w": 100}},
    {"name": "connector 1 with Inlet only makes no event", "rules": ["M3", "M7"], "connector_id": 1,
     "sampled_values": [{"measurand": "Power.Active.Import", "value": "999", "location": "Inlet"}],
     "expect": null},
    {"name": "connector 1 ignores Body for power", "rules": ["M3", "M7"], "connector_id": 1,
     "sampled_values": [{"measurand": "Power.Active.Import", "value": "5", "location": "Body"}],
     "expect": null},
    {"name": "connector 0 prefers Inlet over Outlet", "rules": ["M3"], "connector_id": 0,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "100", "location": "Outlet"},
       {"measurand": "Power.Active.Import", "value": "999", "location": "Inlet"}],
     "expect": {"power_w": 999}},
    {"name": "connector 0 falls back to Outlet", "rules": ["M3"], "connector_id": 0,
     "sampled_values": [{"measurand": "Power.Active.Import", "value": "100"}],
     "expect": {"power_w": 100}},
    {"name": "connector 0 chooses the location per measurand", "rules": ["M3"], "connector_id": 0,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "999", "location": "Inlet"},
       {"value": "5000", "location": "Outlet"}],
     "expect": {"power_w": 999, "energy_wh": 5000}},
    {"name": "OCPP 1.6 section 3.16.3: connector 0, three Inlet phases of current", "rules": ["M3", "M4"], "connector_id": 0,
     "sampled_values": [
       {"measurand": "Current.Import", "value": "10", "unit": "A", "phase": "L1", "location": "Inlet"},
       {"measurand": "Current.Import", "value": "11", "unit": "A", "phase": "L2", "location": "Inlet"},
       {"measurand": "Current.Import", "value": "12", "unit": "A", "phase": "L3", "location": "Inlet"}],
     "expect": {"current_a": 12}},
    {"name": "SoC comes from any location", "rules": ["M3"], "connector_id": 1,
     "sampled_values": [{"measurand": "SoC", "value": "57", "location": "EV"}],
     "expect": {"soc_percent": 57}},
    {"name": "SoC has no phases: the first value wins", "rules": ["M3", "M5"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "SoC", "value": "40", "phase": "L1"},
       {"measurand": "SoC", "value": "57", "phase": "L2"}],
     "expect": {"soc_percent": 40}},
    {"name": "an unphased value wins over phases", "rules": ["M4"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "100", "phase": "L1"},
       {"measurand": "Power.Active.Import", "value": "300"}],
     "expect": {"power_w": 300}},
    {"name": "the unphased rule is per measurand", "rules": ["M4"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "5000"},
       {"measurand": "Current.Import", "value": "10", "phase": "L1"},
       {"measurand": "Current.Import", "value": "12", "phase": "L2"}],
     "expect": {"power_w": 5000, "current_a": 12}},
    {"name": "energy is summed over phases", "rules": ["M4"], "connector_id": 1,
     "sampled_values": [
       {"value": "1000", "phase": "L1"}, {"value": "2000", "phase": "L2"}, {"value": "3000", "phase": "L3"}],
     "expect": {"energy_wh": 6000}},
    {"name": "L1 and L1-N are not both counted", "rules": ["M4"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "100", "phase": "L1"},
       {"measurand": "Power.Active.Import", "value": "100", "phase": "L1-N"},
       {"measurand": "Power.Active.Import", "value": "200", "phase": "L2"}],
     "expect": {"power_w": 300}},
    {"name": "Lx-N stands in for a missing Lx", "rules": ["M4"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "100", "phase": "L1-N"},
       {"measurand": "Power.Active.Import", "value": "200", "phase": "L2"}],
     "expect": {"power_w": 300}},
    {"name": "current is the maximum, L-N included", "rules": ["M4"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "Current.Import", "value": "8", "phase": "L1-N"},
       {"measurand": "Current.Import", "value": "12", "phase": "L2"},
       {"measurand": "Current.Import", "value": "10", "phase": "L3-N"}],
     "expect": {"current_a": 12}},
    {"name": "missing phases are summed as they are", "rules": ["M4"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "100", "phase": "L1"},
       {"measurand": "Power.Active.Import", "value": "200", "phase": "L2"}],
     "expect": {"power_w": 300}},
    {"name": "N and line-to-line phases are ignored", "rules": ["M4"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "100", "phase": "L1"},
       {"measurand": "Power.Active.Import", "value": "7", "phase": "N"},
       {"measurand": "Power.Active.Import", "value": "9", "phase": "L1-L2"}],
     "expect": {"power_w": 100}},
    {"name": "only N makes no event", "rules": ["M4", "M7"], "connector_id": 1,
     "sampled_values": [{"measurand": "Power.Active.Import", "value": "7", "phase": "N"}],
     "expect": null},
    {"name": "duplicate unphased values: the first wins", "rules": ["M5"], "connector_id": 1,
     "sampled_values": [
       {"value": "100", "context": "Sample.Periodic"},
       {"value": "200", "context": "Transaction.Begin"}],
     "expect": {"energy_wh": 100, "context": "Sample.Periodic"}},
    {"name": "duplicate phase values: the first wins", "rules": ["M5"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "100", "phase": "L1"},
       {"measurand": "Power.Active.Import", "value": "400", "phase": "L1"},
       {"measurand": "Power.Active.Import", "value": "200", "phase": "L2"}],
     "expect": {"power_w": 300}},
    {"name": "context: the first used value in array order, none if it has none", "rules": ["M6"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "5000"},
       {"value": "100", "context": "Transaction.Begin"}],
     "expect": {"power_w": 5000, "energy_wh": 100}},
    {"name": "context: the first used value, whatever its measurand", "rules": ["M6"], "connector_id": 1,
     "sampled_values": [
       {"value": "100", "context": "Transaction.Begin"},
       {"measurand": "Power.Active.Import", "value": "5000", "context": "Sample.Periodic"}],
     "expect": {"power_w": 5000, "energy_wh": 100, "context": "Transaction.Begin"}},
    {"name": "context: values that are not used don't count", "rules": ["M6"], "connector_id": 1,
     "sampled_values": [
       {"value": "1", "format": "SignedData", "context": "Trigger"},
       {"value": "100", "context": "Sample.Clock"}],
     "expect": {"energy_wh": 100, "context": "Sample.Clock"}},
    {"name": "context: a shadowed phased value doesn't count", "rules": ["M6"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "100", "phase": "L1", "context": "Trigger"},
       {"measurand": "Power.Active.Import", "value": "300", "context": "Sample.Clock"}],
     "expect": {"power_w": 300, "context": "Sample.Clock"}},
    {"name": "context: array order, not phase order", "rules": ["M6"], "connector_id": 1,
     "sampled_values": [
       {"measurand": "Power.Active.Import", "value": "200", "phase": "L2", "context": "Trigger"},
       {"measurand": "Power.Active.Import", "value": "100", "phase": "L1", "context": "Sample.Clock"}],
     "expect": {"power_w": 300, "context": "Trigger"}},
    {"name": "context: an unknown value is null", "rules": ["M6"], "connector_id": 1,
     "sampled_values": [{"value": "100", "context": "Weird"}],
     "expect": {"energy_wh": 100}},
    {"name": "an empty element makes no event", "rules": ["M7"], "connector_id": 1,
     "sampled_values": [],
     "expect": null}
  ],
  "timestamps": [
    {"name": "UTC", "rules": ["T1"], "input": "2026-10-23T09:15:00Z", "expect": "2026-10-23T09:15:00Z"},
    {"name": "offset is converted", "rules": ["T1"], "input": "2026-10-23T11:15:00+02:00", "expect": "2026-10-23T09:15:00Z"},
    {"name": "no zone is UTC", "rules": ["T1"], "input": "2026-10-23T09:15:00", "expect": "2026-10-23T09:15:00Z"},
    {"name": "no zone, with fraction", "rules": ["T1"], "input": "2026-10-23T09:15:00.250", "expect": "2026-10-23T09:15:00.25Z"},
    {"name": "offset without a colon", "rules": ["T1"], "input": "2026-10-23T11:15:00+0200", "expect": "2026-10-23T09:15:00Z"},
    {"name": "offset of hours only", "rules": ["T1"], "input": "2026-10-23T11:15:00+02", "expect": "2026-10-23T09:15:00Z"},
    {"name": "negative offset without a colon", "rules": ["T1"], "input": "2026-10-23T04:45:00-0430", "expect": "2026-10-23T09:15:00Z"},
    {"name": "fraction and a zero offset without a colon", "rules": ["T1"], "input": "2026-10-23T09:15:00.000+0000", "expect": "2026-10-23T09:15:00Z"},
    {"name": "fraction and offset with a colon", "rules": ["T1"], "input": "2026-10-23T11:15:00.5+02:00", "expect": "2026-10-23T09:15:00.5Z"},
    {"name": "fraction and Z", "rules": ["T1"], "input": "2026-10-23T09:15:00.123456789Z", "expect": "2026-10-23T09:15:00.123456789Z"},
    {"name": "a date only is not a timestamp", "rules": ["T1"], "input": "2026-10-23", "expect": null},
    {"name": "text is not a timestamp", "rules": ["T1"], "input": "yesterday", "expect": null},
    {"name": "empty is not a timestamp", "rules": ["T1"], "input": "", "expect": null},
    {"name": "a one-digit offset is not a timestamp", "rules": ["T1"], "input": "2026-10-23T11:15:00+2", "expect": null},
    {"name": "an offset with minutes out of range is not a timestamp", "rules": ["T1"], "input": "2026-10-23T11:15:00+0260", "expect": null},
    {"name": "basic format is not a timestamp", "rules": ["T1"], "input": "20261023T091500Z", "expect": null},
    {"name": "a space instead of T is not a timestamp", "rules": ["T1"], "input": "2026-10-23 09:15:00Z", "expect": null}
  ]
}
