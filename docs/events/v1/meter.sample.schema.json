{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "meter.sample, v1",
  "description": "One MeterValue element of a MeterValues request, with units normalised to Wh, W, A and percent. timestamp is the element's timestamp. README.md says which sampled values are used.",
  "$ref": "envelope.schema.json",
  "properties": {
    "type": { "const": "meter.sample" },
    "connector_id": { "type": "integer" },
    "timestamp": { "type": "string" },
    "data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "data": {
      "type": "object",
      "properties": {
        "transaction_id": {
          "description": "MeterValues.req transactionId, or null.",
          "type": ["integer", "null"]
        },
        "energy_wh": {
          "description": "Energy.Active.Import.Register, in Wh, or null.",
          "type": ["number", "null"]
        },
        "power_w": {
          "description": "Power.Active.Import, in W, or null.",
          "type": ["number", "null"]
        },
        "current_a": {
          "description": "Current.Import, in A, or null.",
          "type": ["number", "null"]
        },
        "soc_percent": {
          "description": "SoC, in percent, or null.",
          "type": ["number", "null"]
        },
        "context": {
          "description": "OCPP 1.6 ReadingContext of the values used, or null when the charger left it out (OCPP's default is Sample.Periodic).",
          "enum": ["Interruption.Begin", "Interruption.End", "Sample.Clock", "Sample.Periodic", "Transaction.Begin", "Transaction.End", "Trigger", "Other", null]
        }
      },
      "required": ["transaction_id", "energy_wh", "power_w", "current_a", "soc_percent", "context"]
    }
  }
}
